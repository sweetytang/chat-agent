# ========================================================
# Open Agent 云端生产部署环境变量配置文件模板
# 请复制本文件为 .env.production 并修改为实际配置
# ========================================================

# 暴露给外部访问的后端端口（默认 10000）
API_PORT=10000

# PostgreSQL 数据库配置
POSTGRES_DB=open_agent
POSTGRES_USER=open_agent
POSTGRES_PASSWORD=#dt240411

# JWT 签名密钥（生产环境请务必替换为高强度随机字符串）
OPEN_AGENT_JWT_SECRET=generate_a_random_jwt_secret_here

# LLM 服务提供商配置
OPEN_AGENT_PROVIDER=openai-compatible
OPEN_AGENT_API_KEY=sk-lMuMOGX8ogD6AIFoaKARFVMqnPRiop3mAnh2gDeS2LDIVLNjzdpGKZzBykEfzwu1
OPEN_AGENT_BASE_URL=https://airouter.tenasourcing.com/v1
OPEN_AGENT_MODEL_NAME=gemini-3.8-flash-high
OPEN_AGENT_THINKING_ENABLED=true

# MCP 凭据加密密钥（32字节 base64url 编码密钥，一旦设定请勿更改）
OPEN_AGENT_MCP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# CORS 跨域配置：允许本地客户端直连或指定域名
# 若使用客户端本地 CLI 代理，CORS 亦可设为 true 兼容所有源
OPEN_AGENT_CORS_ALLOW_ALL=true
# 或者关闭 allow_all 并指定可信域名：
# OPEN_AGENT_CORS_ALLOW_ALL=false
# OPEN_AGENT_CORS_ORIGINS=https://agent.tenasourcing.com,https://ai.tenasourcing.com,http://localhost:10001

# 后端进程工作线程数
OPEN_AGENT_WORKERS=2
