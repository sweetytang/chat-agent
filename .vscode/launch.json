    "version": "0.0.1",
    "configurations": [
        {
            "name": "Lui-Agent Debugger",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/apps/lui-agent/backend/.venv/bin/python",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/apps/lui-agent/backend",
            "envFile": "${workspaceFolder}/apps/lui-agent/backend/.env",
            "justMyCode": true,
            "jinja": true
        }
    ]
}