{
    "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "fastapi.entryPoint": "app.main:app",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/backend/apps/api-server",
        "${workspaceFolder}/backend/packages/lui-agent-runtime/src"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "backend/apps/api-server/tests",
        "backend/packages/lui-agent-runtime/tests"
    ],
    "python.testing.cwd": "${workspaceFolder}/backend",
    "ruff.cwd": "${workspaceFolder}/backend"
}