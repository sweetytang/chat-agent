{
  "name": "open-agent-frontend-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter open-agent-web dev",
    "build": "pnpm --filter open-agent-web build",
    "lint": "pnpm --filter open-agent-web lint",
    "format": "pnpm --filter open-agent-web format",
    "format:check": "pnpm --filter open-agent-web format:check",
    "test": "pnpm --filter open-agent-web test",
    "generate-api-types": "pnpm --filter @lui-agent/api-types generate",
    "check-api-types": "pnpm --filter @lui-agent/api-types check"
  }
}